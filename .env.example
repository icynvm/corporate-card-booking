# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Required at runtime; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------- Sessions / secrets ----------
# HMAC key for signing session cookies (REQUIRED in production).
# Generate with: openssl rand -base64 48. Rotating it logs everyone out.
SESSION_SECRET="your-long-random-session-secret"
# Signs approval magic links. Legacy: also a fallback for SESSION_SECRET and used to
# verify old SHA-256 password hashes until users log in again.
APPROVAL_SECRET="your-random-secret-key-here"
# Bearer token required by cron endpoints (/api/payments/cron/reminders)
CRON_SECRET="your-cron-secret"

# ---------- Email (Resend) ----------
RESEND_API_KEY="re_xxxxxxxxxxxx"
# From address (must be on a domain verified in Resend), e.g. "Card Booking <noreply@example.com>".
# Can also be set from the admin settings page (app_settings table), which takes precedence.
SENDER_EMAIL=""
# Recipient of approval-request emails. Also overridable in admin settings.
MANAGER_EMAIL=""

# ---------- App ----------
# Public base URL of the app (used in emails / links / OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# IANA timezone used for payment due dates / reminders (e.g. Asia/Bangkok)
BUSINESS_TZ="Asia/Bangkok"

# ---------- Facebook Marketing API (optional) ----------
FACEBOOK_APP_ID="your-app-id"
FACEBOOK_APP_SECRET="your-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"
