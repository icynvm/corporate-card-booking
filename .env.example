# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing secret (REQUIRED in production). Long random, e.g. `openssl rand -base64 48`
SESSION_SECRET="your-long-random-session-secret"

# Approval secret (for magic links). Legacy: also used as a fallback for SESSION_SECRET
# and to verify old SHA-256 password hashes until users log in again.
APPROVAL_SECRET="your-random-secret-key-here"

# Secret for authenticating cron endpoints
CRON_SECRET="your-cron-secret"

# Facebook Marketing API
FACEBOOK_APP_ID="your-app-id"
FACEBOOK_APP_SECRET="your-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"
